{
  "name": "paganel-ui",
  "version": "0.1.0",
  "description": "A Tailwind CSS based design system: component classes + vanilla JS behaviors, framework-agnostic (Rails, plain HTML, or any JS toolchain).",
  "type": "module",
  "license": "MIT",
  "author": "ihortok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihortok/paganel-ui.git"
  },
  "homepage": "https://github.com/ihortok/paganel-ui#readme",
  "bugs": {
    "url": "https://github.com/ihortok/paganel-ui/issues"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "design-system",
    "css",
    "ui-components",
    "component-library",
    "rails"
  ],
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./css/index.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": "./dist/index.global.js",
    "./css": "./css/index.css",
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "README.md"
  ],
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
